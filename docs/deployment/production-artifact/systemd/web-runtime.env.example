# Install as root-owned mode 0640 at /etc/leetplus/web-runtime.env.
#
# This file is intentionally separate from API runtime.env. The Web/BFF does
# not receive DATABASE_URL, JWT/encryption material, provider credentials or
# SMTP secrets. Paired API_URL and release identity come from the protected
# blue|green slot env, while the fail-closed effect overlay is loaded last.
NODE_ENV=production
