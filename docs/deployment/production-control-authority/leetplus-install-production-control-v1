def verify_installed(node_path, verifier_path, release_sha, fixture_root):
    arguments = [node_path, verifier_path, "--release-sha", release_sha]
    environment = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8", "TZ": "UTC"}
    if fixture_root:
        arguments.extend(["--fixture-root", fixture_root])
        environment["LEETPLUS_PRODUCTION_CONTROL_FIXTURE_CONFIRMATION"] = "verify-installed-production-control-generation"
    else:
        arguments.append("--require-root-authority")
    completed = subprocess.run(
        arguments,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=45,
        check=False,
        env=environment,
    )
    if (
        completed.returncode != 0
        or b"PRODUCTION_CONTROL_INSTALLED_GENERATION=PASS\n" not in completed.stdout
        or f"PRODUCTION_CONTROL_RELEASE_SHA={release_sha}\n".encode() not in completed.stdout
        or completed.stderr
    ):
        sys.stderr.buffer.write(completed.stderr[:8192])
        die("installed-generation verifier rejected the published generation")
    return completed.stdout.decode("utf-8", errors="strict")


