# Non-secret fixed-destination profile. Materialize separately for the selected
# slot as /etc/leetplus/identity-mail-smtp-egress-<slot>.env. Keep disabled
# until the reviewed production change window.
IDENTITY_MAIL_SMTP_EGRESS_ENABLED=false
IDENTITY_MAIL_SMTP_EGRESS_RELEASE_SHA=<same-exact-40-character-release-sha>
IDENTITY_MAIL_SMTP_EGRESS_LISTEN_HOST=127.0.0.1
IDENTITY_MAIL_SMTP_EGRESS_LISTEN_PORT=4465
IDENTITY_MAIL_SMTP_EGRESS_HEALTH_HOST=127.0.0.1
IDENTITY_MAIL_SMTP_EGRESS_HEALTH_PORT=4466
IDENTITY_MAIL_SMTP_EGRESS_TARGET_HOST=<exact-smtp-provider-dns-name>
IDENTITY_MAIL_SMTP_EGRESS_TARGET_PORT=465
IDENTITY_MAIL_SMTP_EGRESS_CONNECT_TIMEOUT_MS=10000
IDENTITY_MAIL_SMTP_EGRESS_IDLE_TIMEOUT_MS=120000
IDENTITY_MAIL_SMTP_EGRESS_MAX_CONNECTIONS=4
