{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "guest-game:bot-consumer": "node dist/guest-gamification/guest-game-delivery-bot-consumer.cli",
    "guest-game:telegram-edge": "node dist/guest-portal/telegram-edge-adapter.cli",
    "guest-game:telegram-poller": "node dist/guest-portal/telegram-edge-poller.cli",
    "config:validate:production": "node dist/config/validate-production-environment.cli.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:ci:boundary": "eslint --rule \"prettier/prettier: off\" src/app.controller.ts src/app.controller.spec.ts src/app.service.ts src/app.module.ts src/main.ts src/config/environment-validation.ts src/config/environment-validation.spec.ts src/config/validate-production-environment.cli.ts src/auth/auth.module.ts src/auth/capabilities.ts src/auth/roles.guard.ts src/auth/roles.guard.spec.ts src/auth/operational-b2b-auth-boundary.spec.ts src/categories/categories.controller.ts src/dashboard/dashboard.controller.ts src/products/products.controller.ts src/stores/stores.controller.ts src/suppliers/suppliers.controller.ts src/tenancy/tenant-context.service.ts src/tenancy/tenant-context.service.spec.ts src/users/user-invite-token.ts src/integrations/secret-encryption.service.ts src/integrations/secret-encryption.service.spec.ts",
    "typecheck": "tsc --noEmit --project tsconfig.build.json",
    "test": "jest",
    "test:ci": "jest --ci --runInBand",
    "test:ci:focused": "jest --ci --runInBand --runTestsByPath src/app.controller.spec.ts src/auth/roles.guard.spec.ts src/auth/operational-b2b-auth-boundary.spec.ts src/config/environment-validation.spec.ts src/guest-gamification/guest-gamification.controller.spec.ts src/integrations/secret-encryption.service.spec.ts src/tenancy/tenant-context.service.spec.ts",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs-modules/mailer": "^2.3.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/client": "6.19.3",
    "csv-parse": "^6.2.1",
    "exceljs": "^4.4.0",
    "express": "5.2.1",
    "nodemailer": "^8.0.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "undici": "6.25.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
