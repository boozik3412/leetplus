# Reviewed, user-initiated public guest authentication profile.
# This layer is loaded only by the API slot after canary-safe.env. It enables
# one bounded SMS.ru Callcheck flow; every scheduler and reward/delivery worker
# remains fail-closed by the preceding safety overlay.
GUEST_PORTAL_USER_CALL_ENABLED=true
GUEST_PORTAL_USER_CALL_PROVIDER=SMS_RU_CALLCHECK
GUEST_PORTAL_USER_CALL_SMS_RU_BASE_URL=https://sms.ru
GUEST_PORTAL_USER_CALL_PROVIDER_TIMEOUT_MS=8000
