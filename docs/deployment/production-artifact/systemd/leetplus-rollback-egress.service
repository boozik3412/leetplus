[Unit]
Description=LeetPlus scheduler-free N-1 exact UID egress fence
After=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/leetplus/apply-legacy-rollback-egress.sh
ExecReload=/usr/local/libexec/leetplus/apply-legacy-rollback-egress.sh
ExecStartPost=/usr/local/libexec/leetplus/apply-legacy-rollback-egress.sh --verify
RemainAfterExit=yes
TimeoutStartSec=30
TimeoutStopSec=15
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
