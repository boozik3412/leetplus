def parse_manifest(value, label):
    try:
        text = value.decode("utf-8", errors="strict")
    except UnicodeDecodeError:
        die(f"{label} is not UTF-8")
    if not text.endswith("\n") or text.endswith("\n\n"):
        die(f"{label} must end with exactly one LF")
    result = {}
    prior = None
    for line in text[:-1].split("\n"):
        match = re.fullmatch(r"([0-9a-f]{64})  \.\/([A-Za-z0-9_.@+/-]+)", line)
        if not match:
            die(f"{label} contains a malformed line")
        digest, source = match.groups()
        assert_safe_source(source, label)
        if source in result or (prior is not None and source.encode() <= prior.encode()):
            die(f"{label} is duplicate or not sorted")
        result[source] = digest
        prior = source
    return result


def parse_allowlist(value):
    try:
        text = value.decode("utf-8", errors="strict")
    except UnicodeDecodeError:
        die("payload allowlist is not UTF-8")
    if not text.endswith("\n") or text.endswith("\n\n"):
        die("payload allowlist must end with exactly one LF")
    result = text[:-1].split("\n")
    prior = None
    for source in result:
        assert_safe_source(source, "payload allowlist")
        if prior is not None and source.encode() <= prior.encode():
            die("payload allowlist is duplicate or not sorted")
        prior = source
    return result


def parse_install_map(value, manifest):
    if sha256_bytes(value) != EXPECTED_INSTALL_MAP_SHA256:
        die("install map differs from the separately reviewed authority pin")
    try:
        text = value.decode("utf-8", errors="strict")
    except UnicodeDecodeError:
        die("install map is not UTF-8")
    if not text.endswith("\n") or text.endswith("\n\n"):
        die("install map must end with exactly one LF")
    result = []
    destinations = set()
    prior = None
    for line in text[:-1].split("\n"):
        fields = line.split("\t")
        if len(fields) != 3:
            die("install map line is not exact TSV")
        source, destination, mode_text = fields
        assert_safe_source(source, "install map source")
        if (
            not re.fullmatch(r"/[A-Za-z0-9_.@+/-]+", destination)
            or any(part in ("", ".", "..") for part in destination[1:].split("/"))
        ):
            die(f"install map destination is unsafe: {destination!r}")
        if mode_text not in ("0400", "0444", "0500", "0555"):
            die(f"install map mode is forbidden: {mode_text}")
        if source not in manifest or destination in destinations:
            die("install map source is unbound or destination is duplicate")
        if prior is not None and line.encode() <= prior.encode():
            die("install map is duplicate or not canonically sorted")
        prior = line
        destinations.add(destination)
        result.append((source, destination, int(mode_text, 8)))
    return result


def verify_artifact(node_path, generation_root, release_sha, fixture_mode):
    verifier = os.path.join(generation_root, *ARTIFACT_VERIFIER_SOURCE.split("/"))
    arguments = [
        node_path, verifier, "--artifact-root", generation_root,
        "--expected-release-sha", release_sha,
    ]
    if not fixture_mode:
        arguments.append("--require-root-authority")
    completed = subprocess.run(
        arguments,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=30,
        check=False,
        env={"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8", "TZ": "UTC"},
    )
    expected_authority = b"NOT_REQUESTED" if fixture_mode else b"REQUIRED"
    if (
        completed.returncode != 0
        or b"PRODUCTION_CONTROL_ARTIFACT_INTEGRITY=PASS\n" not in completed.stdout
        or f"PRODUCTION_CONTROL_RELEASE_SHA={release_sha}\n".encode() not in completed.stdout
        or b"PRODUCTION_CONTROL_ROOT_AUTHORITY=" + expected_authority + b"\n" not in completed.stdout
        or completed.stderr
