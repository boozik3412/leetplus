# Protected as /etc/leetplus/corporate-runtime.env (root:leetplus-runtime 0640).
# Never add guest JWT/referral/provider secrets to this file.
DATABASE_URL=postgresql://leetplus_api_corporate:<secret>@127.0.0.1:5432/leetplus?schema=public&connection_limit=<approved>&pool_timeout=5&connect_timeout=5&sslmode=verify-full
JWT_SECRET=<independent-32-plus-character-secret>
APP_ENCRYPTION_KEY=<independent-32-plus-character-secret>
INTEGRATION_ENCRYPTION_KEY=<independent-32-plus-character-secret>
IDENTITY_EMAIL_FINGERPRINT_HMAC_KEY=<independent-32-plus-character-secret>
IDENTITY_EMAIL_FINGERPRINT_HMAC_KEY_VERSION=v1
IDENTITY_MAIL_ENCRYPTION_KEY=<exact-unpadded-32-byte-base64url-key>
IDENTITY_MAIL_ENCRYPTION_KEY_VERSION=v1
IDENTITY_MAIL_AAD_ENVIRONMENT=production
SYNC_SERVICE_TOKEN=<independent-32-plus-character-secret>
