# Protected /etc/leetplus/slots/green.env metadata.
RELEASE_SHA=<exact-40-character-release-sha>
WEB_BUILD_ID=<same-exact-40-character-release-sha>
EXPECTED_DATABASE_MIGRATION=<exact-migration-name-from-provenance>
EXPECTED_DATABASE_MIGRATION_COUNT=<exact-migration-count-from-provenance>
BUILD_TIME=<UTC-release-window-timestamp>
# Keep both values OFF for ordinary releases. A reviewed support-schema rollout
# may temporarily set ALLOW_CURRENT_187 or ALLOW_CURRENT_188 only together with
# GUEST_BUG_REPORTING_MODE=OFF on the exact target release.
GUEST_BUG_REPORTING_MODE=OFF
GUEST_SUPPORT_SCHEMA_BRIDGE_MODE=OFF
API_BIND_HOST=127.0.0.1
PORT=4200
WEB_PORT=3200
API_URL=http://127.0.0.1:4200
