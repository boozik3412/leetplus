# Copy required values into /etc/leetplus/langame-daily-worker.env.
# The real file is operator-owned: root:leetplus-api-runtime 0640.

DATABASE_URL=
APP_ENCRYPTION_KEY=
INTEGRATION_ENCRYPTION_KEY=
LANGAME_DISCREPANCY_LOG_ROOT=/var/lib/leetplus/langame-sync

# The worker is the only unattended owner. API-slot and scheduled HTTP owners
# stay disabled even while this worker is live.
LANGAME_DAILY_WORKER_ENABLED=true
LANGAME_DAILY_WORKER_LIVE=true
LANGAME_DAILY_WORKER_TENANT_SLUG=demo
LANGAME_DAILY_WORKER_CANARY=true
LANGAME_DAILY_SYNC_SCHEDULER_ENABLED=false
LANGAME_SCHEDULED_HTTP_ENABLED=false

# Optional only during a bounded canary. Delete it for the nightly prior-day run.
# LANGAME_DAILY_WORKER_DATE=2026-09-02
