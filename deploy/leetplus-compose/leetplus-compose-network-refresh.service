[Unit]
Description=Refresh exact LeetPlus provider DNS addresses
Requires=leetplus-compose-network.service
After=leetplus-compose-network.service
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/leetplus-compose-network refresh
UMask=0077
TimeoutStartSec=90s
Restart=on-failure
RestartSec=30s
